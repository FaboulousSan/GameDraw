{
  "identifier": "default",
  "description": "Capacités de la fenêtre principale de GameDraw. Ajouter ce fichier remplace la capacité implicite de Tauri — core:default est donc explicitement listé pour ne rien perdre des permissions de base (fenêtre, app).",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "notification:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "core:webview:allow-create-webview-window",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-start-dragging",
    "opener:default",
    "core:window:allow-show",
    "core:window:allow-set-focus"
  ]
}
